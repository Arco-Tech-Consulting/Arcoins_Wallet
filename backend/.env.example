# Base de datos: valores de ejemplo
DATABASE_URL=postgresql://usuario:contrasena@host:5432/nombre_base_de_datos
PORT=3000

# Gemini: configuración exclusiva del backend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000

# Autenticación JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Correos directos con SES. Activar solo después de configurar y desplegar.
WELCOME_EMAIL_ENABLED=false
TRANSACTION_EMAIL_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
ARCOINS_APP_URL=https://arcoinswallet.vercel.app

# Hasta dos modelos alternativos separados por comas, verificados en AI Studio.
GEMINI_FALLBACK_MODELS=
