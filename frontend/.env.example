# ============================================================
# Arcoins Wallet - Frontend
# Copia este archivo a .env y ajusta los valores según el entorno.
# ============================================================

# URL base de la API del backend.
#   - Desarrollo con mocks: /api (usa el proxy de Vite para el backend local)
#   - Producción (Vercel):   https://arcoins-wallet.onrender.com/api
VITE_API_URL=/api

# Activa los mocks de MSW (solo aplica en modo desarrollo: npm run dev).
# En producción (vercel build) esto se ignora y se usa el backend real.
VITE_ENABLE_MOCKS=true

# Solo para desarrollo: destino del proxy de Vite cuando los mocks están
# desactivados (VITE_ENABLE_MOCKS=false) y el backend corre en local.
VITE_PROXY_TARGET=http://localhost:3000